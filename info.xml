<?xml version="1.0"?>
<extension key="com.skvare.searchkitleaflet" type="module">
  <file>searchkitleaflet</file>
  <name>SearchKit Leaflet Map</name>
  <description>Adds an interactive Leaflet map display type to CiviCRM SearchKit, supporting marker clustering, viewport-bound filtering, and token-based popups.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Sunil Pawar</author>
    <email>sunil@skvare.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/skvare/com.skvare.searchkitleaflet</url>
    <url desc="Documentation">https://github.com/skvare/com.skvare.searchkitleaflet/wiki</url>
    <url desc="Support">https://github.com/skvare/com.skvare.searchkitleaflet/issues</url>
  </urls>
  <civix>
    <namespace>CRM/SearchKitLeaflet</namespace>
  </civix>
  <requires>
    <ext>org.civicrm.search_kit</ext>
  </requires>
  <releaseDate>2026-05-09</releaseDate>
  <version>1.0.0</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>6.10</ver>
  </compatibility>
  <classloader>
    <psr4 prefix="Civi\SearchKitLeaflet\" path="Civi/SearchKitLeaflet"/>
  </classloader>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
    <mixin>mgd-php@1.0.0</mixin>
  </mixins>
</extension>
